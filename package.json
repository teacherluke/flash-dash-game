{
  "name": "flash-dash-game",
  "version": "1.0.0",
  "description": "Cambridge & IB Flashcard Learning Game",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "build": "mkdir -p dist && cp index.html styles.css script.js server.js package.json dist/ && cp -r flashcards_*.txt igcse/ dist/ 2>/dev/null || cp flashcards_*.txt dist/",
    "deploy": "vercel --prod"
  },
  "keywords": [
    "flashcards",
    "education",
    "learning",
    "cambridge",
    "IB"
  ],
  "author": "A-STUDENT",
  "license": "MIT",
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "express": "^4.18.2",
    "express-session": "^1.17.3"
  }
}
